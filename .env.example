# Copy to .env.rethread.local (ignored). Never paste secret values into chat.
# Production: configure these in provider runtime secret settings, not Docker build args.
DATABASE_URL=postgresql://rethread_runtime:REPLACE@HOST:5432/rethread
MIGRATION_DATABASE_URL=postgresql://rethread_migrator:REPLACE@HOST:5432/rethread
PUBLIC_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001
BUILD_ID=development
SESSION_ENCRYPTION_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
E2B_API_KEY=
E2B_TEMPLATE_ID=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Set these conservatively to the current provider model's actual price, in millionths of USD.
LLM_INPUT_MICROS_PER_MILLION=1000000
LLM_OUTPUT_MICROS_PER_MILLION=4000000
TENANT_DAILY_BUDGET_MICROS=0
GLOBAL_DAILY_BUDGET_MICROS=0
API_DB_POOL_SIZE=5
WORKER_DB_POOL_SIZE=3
# Owner deployment tooling only. These are not needed by runtime containers.
RENDER_API_KEY=

# Free-only owner constraint. Do not add payment methods or upgrade providers.
FREE_ONLY=true
WORKER_MODE=github-actions
WORKER_EXIT_WHEN_IDLE=true
MAX_JOBS_PER_INVOCATION=2
CONTROL_REPOSITORY=dineshsuthar123/Rethread
CONTROL_REPOSITORY_ID=1161587671
CONTROL_INSTALLATION_ID=
CONTROL_REF=rethread/implementation
E2B_FREE_ENTITLEMENT_CONFIRMED=false
FREE_LLM_ENTITLEMENT_CONFIRMED=false
LLM_FREE_DAILY_CALL_LIMIT=10
TENANT_ARTIFACT_BYTES=104857600

# Allocate only verified remaining E2B Hobby credits; 0 blocks sandbox creation.
SANDBOX_FREE_CREDIT_BUDGET_MICROS=0
